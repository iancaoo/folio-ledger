# Local demonstration defaults. scripts/setup-local.py generates credentials and
# a persistent APP_KEY in the ignored .env; never use placeholders as real keys.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=13000
APP_KEY=
API_BASE_PATH=/api/
INIT_APP_LANG=zh-CN
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=15432
DB_DATABASE=finance_dev
DB_USER=finance_app
DB_PASSWORD=
TZ=UTC
INIT_ROOT_EMAIL=admin@finance.local
INIT_ROOT_PASSWORD=
INIT_ROOT_NICKNAME=Finance 开发管理员
APPEND_PRESET_BUILT_IN_PLUGINS=@finance/plugin-core
FINANCE_DEMO_MODE=true
